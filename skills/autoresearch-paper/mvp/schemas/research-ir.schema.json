{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WdBlink/autoresearch-paper/schemas/mvp/research-ir-v1.json",
  "title": "Autoresearch Paper MVP-0 Research IR v1",
  "description": "A frozen, falsifiable research contract. It intentionally excludes worker, watchdog, transport, dashboard, and paper-runtime configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ir_id",
    "version",
    "parent_ir_sha256",
    "source",
    "problem_statement",
    "central_claim",
    "falsification_conditions",
    "related_work_gap",
    "baseline_contract",
    "metric_contract",
    "evaluator_spec",
    "allowed_search_space",
    "forbidden_changes",
    "experiment_plan",
    "budget",
    "stop_rules"
  ],
  "properties": {
    "schema_version": {
      "const": "research-ir/v1"
    },
    "ir_id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "parent_ir_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_task_id",
        "source_summary",
        "brief_artifact",
        "workspace_root",
        "code_root"
      ],
      "properties": {
        "source_task_id": {
          "type": "string",
          "minLength": 8
        },
        "source_summary": {
          "type": "string",
          "minLength": 24
        },
        "brief_artifact": {
          "$ref": "#/$defs/hashed_artifact"
        },
        "workspace_root": {
          "type": "string",
          "pattern": "^/"
        },
        "code_root": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "problem_statement": {
      "type": "string",
      "minLength": 40
    },
    "central_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "baseline_id",
        "primary_metric_id",
        "evaluation_scope"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 40
        },
        "baseline_id": {
          "$ref": "#/$defs/id"
        },
        "primary_metric_id": {
          "$ref": "#/$defs/id"
        },
        "evaluation_scope": {
          "type": "string",
          "minLength": 24
        }
      }
    },
    "falsification_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "metric_id",
          "aggregation",
          "operator",
          "value",
          "decision"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "metric_id": {
            "$ref": "#/$defs/id"
          },
          "aggregation": {
            "enum": [
              "estimate",
              "ci_lower",
              "ci_upper"
            ]
          },
          "operator": {
            "enum": [
              "<",
              "<=",
              ">",
              ">="
            ]
          },
          "value": {
            "type": "number"
          },
          "decision": {
            "const": "REJECT_CLAIM"
          }
        }
      }
    },
    "related_work_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "evidence_refs"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 40
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "locator",
              "supports",
              "sha256"
            ],
            "properties": {
              "source_id": {
                "$ref": "#/$defs/id"
              },
              "locator": {
                "type": "string",
                "minLength": 4
              },
              "supports": {
                "type": "string",
                "minLength": 12
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "baseline_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_id",
        "status",
        "description",
        "source_artifacts",
        "implementation_artifact",
        "implementation_sha256",
        "training_argv",
        "comparison_scope"
      ],
      "properties": {
        "baseline_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "PLANNED",
            "READY"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 24
        },
        "source_artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/hashed_artifact"
          }
        },
        "implementation_artifact": {
          "type": "string",
          "pattern": "^/"
        },
        "implementation_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "training_argv": {
          "$ref": "#/$defs/argv"
        },
        "comparison_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 4
          }
        }
      }
    },
    "metric_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_metric",
        "guardrails"
      ],
      "properties": {
        "primary_metric": {
          "$ref": "#/$defs/metric"
        },
        "guardrails": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/metric"
          }
        }
      }
    },
    "evaluator_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "working_directory",
        "command_argv",
        "implementation_artifact",
        "implementation_sha256",
        "input_contract",
        "output_contract",
        "metric_bindings"
      ],
      "properties": {
        "status": {
          "enum": [
            "PLANNED",
            "READY"
          ]
        },
        "working_directory": {
          "type": "string",
          "pattern": "^/"
        },
        "command_argv": {
          "$ref": "#/$defs/argv"
        },
        "implementation_artifact": {
          "type": "string",
          "pattern": "^/"
        },
        "implementation_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_contract": {
          "type": "string",
          "minLength": 24
        },
        "output_contract": {
          "type": "string",
          "minLength": 24
        },
        "metric_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric_id",
              "json_path"
            ],
            "properties": {
              "metric_id": {
                "$ref": "#/$defs/id"
              },
              "json_path": {
                "type": "string",
                "pattern": "^\\$\\."
              }
            }
          }
        }
      }
    },
    "allowed_search_space": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "paths",
          "operations"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "description": {
            "type": "string",
            "minLength": 16
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "CREATE",
                "MODIFY",
                "DELETE"
              ]
            }
          }
        }
      }
    },
    "forbidden_changes": {
      "type": "array",
      "minItems": 11,
      "uniqueItems": true,
      "items": {
        "enum": [
          "problem_statement",
          "central_claim",
          "falsification_conditions",
          "related_work_gap",
          "baseline_contract",
          "metric_contract",
          "evaluator_spec",
          "allowed_search_space",
          "experiment_plan",
          "budget",
          "stop_rules"
        ]
      }
    },
    "experiment_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "stage",
          "hypothesis",
          "intervention",
          "controls",
          "expected_observation",
          "falsification_condition_ids",
          "search_space_ids",
          "depends_on",
          "command_argv",
          "expected_artifacts"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "stage": {
            "enum": [
              "EVALUATOR_BUILD",
              "BASELINE",
              "METHOD"
            ]
          },
          "hypothesis": {
            "type": "string",
            "minLength": 24
          },
          "intervention": {
            "type": "string",
            "minLength": 24
          },
          "controls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 4
            }
          },
          "expected_observation": {
            "type": "string",
            "minLength": 16
          },
          "falsification_condition_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "search_space_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "command_argv": {
            "$ref": "#/$defs/argv"
          },
          "expected_artifacts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_experiments",
        "max_failed_experiments",
        "max_wall_clock_seconds"
      ],
      "properties": {
        "max_experiments": {
          "type": "integer",
          "minimum": 1
        },
        "max_failed_experiments": {
          "type": "integer",
          "minimum": 0
        },
        "max_wall_clock_seconds": {
          "type": "integer",
          "minimum": 60
        }
      }
    },
    "stop_rules": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "condition",
          "action",
          "evidence_required"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "condition": {
            "type": "string",
            "minLength": 16
          },
          "action": {
            "enum": [
              "STOP",
              "RECOMPILE"
            ]
          },
          "evidence_required": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 4
            }
          }
        }
      }
    }
  },
  "$defs": {
    "hashed_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregation",
        "operator",
        "value",
        "confidence_level",
        "minimum_seeds"
      ],
      "properties": {
        "aggregation": {
          "enum": [
            "estimate",
            "ci_lower",
            "ci_upper"
          ]
        },
        "operator": {
          "enum": [
            "<",
            "<=",
            ">",
            ">="
          ]
        },
        "value": {
          "type": "number"
        },
        "confidence_level": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 0.999
        },
        "minimum_seeds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "name",
        "direction",
        "unit",
        "acceptance"
      ],
      "properties": {
        "metric_id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 4
        },
        "direction": {
          "enum": [
            "maximize",
            "minimize"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "acceptance": {
          "$ref": "#/$defs/acceptance"
        }
      }
    }
  }
}
