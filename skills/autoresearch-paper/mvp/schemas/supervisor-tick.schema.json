{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoresearch-paper.local/schemas/supervisor-tick.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "controller_id", "next_phase", "observed_phase", "predecessor_tick_sha256", "recorded_at", "result", "schema_version", "sequence", "state_projection"],
  "properties": {
    "action": {"type": "string", "minLength": 1},
    "controller_id": {"type": "string", "pattern": "^mvp0-supervisor-[0-9a-f]{16}$"},
    "next_phase": {"type": "string", "minLength": 1},
    "observed_phase": {"type": "string", "minLength": 1},
    "predecessor_tick_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "recorded_at": {"type": "string", "format": "date-time"},
    "result": {"type": "object"},
    "schema_version": {"const": "mvp0-supervisor-tick/v1"},
    "sequence": {"type": "integer", "minimum": 1},
    "state_projection": {"type": "object"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
